{
  "$schema": "https://tokens.studio/schema",
  "meta": {
    "name": "Tokka Labs · TMS",
    "version": "1.0.0",
    "fidelity": "high",
    "philosophy": "Paper + ink + signal. Mono for positional data, serif for identity. Square corners, hairline borders, dense rows. Saturation reserved for status and direction."
  },

  "font": {
    "serif": "\"Source Serif 4\", \"IBM Plex Serif\", Georgia, serif",
    "mono":  "\"JetBrains Mono\", \"IBM Plex Mono\", ui-monospace, Menlo, monospace",
    "sans":  "\"Inter\", system-ui, -apple-system, sans-serif"
  },

  "color": {
    "surface": {
      "paper":   "#ffffff",
      "paper2":  "#f6f5f2",
      "paper3":  "#ecebe7",
      "panel":   "#0d0c0a",
      "panelInk":  "#ece8dc",
      "panelInk2": "#8a8678"
    },
    "ink": {
      "ink":  "#161513",
      "ink2": "#46423b",
      "ink3": "#6e695f",
      "ink4": "#a09a90"
    },
    "rule": {
      "rule":  "#e6e3dd",
      "rule2": "#c9c5bd"
    },
    "status": {
      "pending":     { "fg": "#a37312", "bg": "#f8ebcb" },
      "confirmed":   { "fg": "#3a5fb0", "bg": "#e2e9f6" },
      "processed":   { "fg": "#2a7560", "bg": "#dfeee7" },
      "settled":     { "fg": "#1f6f4a", "bg": "#dff0e3" },
      "cancelled":   { "fg": "#7a7363", "bg": "#e6e2d6" }
    },
    "signal": {
      "buy":  { "fg": "#1f6f4a", "bg": "#dff0e3" },
      "sell": { "fg": "#a83838", "bg": "#f5dcd7" },
      "warn": { "fg": "#a35c12", "bg": "#f8e5c8" },
      "link": "#365dbb"
    }
  },

  "type": {
    "scale": {
      "10": "10px",
      "11": "11px",
      "12": "12px",
      "13": "13px",
      "15": "15px",
      "18": "18px",
      "22": "22px",
      "26": "26px",
      "42": "42px"
    },
    "letterSpacing": {
      "tight": "-0.01em",
      "flat":  "0em",
      "label": "0.06em"
    },
    "weights": {
      "regular": 400,
      "medium":  500,
      "semibold":600,
      "bold":    700
    }
  },

  "space": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px"
  },

  "radius": {
    "xs": "2px",
    "sm": "3px",
    "md": "4px"
  },

  "row": {
    "dense":  "28px",
    "comfy":  "36px",
    "card":   "52px"
  }
}
