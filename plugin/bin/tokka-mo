#!/usr/bin/env python3
"""tokka-mo — Tokka Labs Middle Office CLI for Claude Code.

This single-file CLI is invoked by:
  • Claude Code's `trade-booking` skill (shell-out)
  • The user directly: `tokka-mo book < payload.json`
  • The slash commands /book /drafts /login

It has no external dependencies — Python 3.10+ stdlib only — so the install
is `chmod +x bin/tokka-mo` and a PATH symlink. No virtualenv, no pip.

Commands:
  login                 interactive login -> mints API token -> saves locally
  logout                revoke current token, clear local credentials
  whoami                show the authenticated user
  refdata refresh       pull /refdata/*.json + /tokens.json -> local cache
  book < payload.json   POST one CASHFLOW or SPOT draft
  book-batch < batch.json  POST N CASHFLOW/SPOT drafts atomically
  drafts list [--status STATUS] [--batch BATCH_ID]  list your drafts
"""
from __future__ import annotations
import argparse
import concurrent.futures
import json
import os
import sys

VERSION = "0.2.0"


# ─────────────────────────────────────────────────────────────────
# Credential storage — JSON file at $CREDS, chmod 600.
#
# Override via $TOKKA_MO_CONFIG_DIR for hermetic tests.
# ─────────────────────────────────────────────────────────────────


class CredsMissing(FileNotFoundError):
    """Raised when load_credentials() can't find a credentials file."""


def _config_dir():
    override = os.environ.get("TOKKA_MO_CONFIG_DIR")
    if override:
        return os.path.expanduser(override)
    if os.name == "nt":
        return os.path.join(os.environ.get("APPDATA", os.path.expanduser("~")), "tokka-mo")
    return os.path.expanduser("~/.config/tokka-mo")


def _creds_path():
    return os.path.join(_config_dir(), "credentials")


def save_credentials(creds: dict) -> None:
    """Write {api_url, username, token, prefix, token_id, expires_at} as JSON.
    Created with mode 0o600 on POSIX. Parents are created with 0o700.
    """
    d = _config_dir()
    os.makedirs(d, exist_ok=True)
    if os.name != "nt":
        os.chmod(d, 0o700)
    p = _creds_path()
    # Write to a temp path then rename, so an interrupted write can't
    # leave a half-formed credentials file.
    tmp = p + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(creds, f, indent=2, sort_keys=True)
    if os.name != "nt":
        os.chmod(tmp, 0o600)
    os.replace(tmp, p)


def load_credentials() -> dict:
    p = _creds_path()
    if not os.path.exists(p):
        raise CredsMissing(f"no credentials at {p}; run: tokka-mo login")
    with open(p, "r", encoding="utf-8") as f:
        return json.load(f)


def clear_credentials() -> None:
    p = _creds_path()
    try:
        os.remove(p)
    except FileNotFoundError:
        pass


# ─────────────────────────────────────────────────────────────────
# Refdata cache — single JSON file at $CACHE.
# Schema: {fetched_at, portfolios, accounts, counterparties, users, tokens}
# ─────────────────────────────────────────────────────────────────
import datetime as _dt


def _cache_dir():
    override = os.environ.get("TOKKA_MO_CACHE_DIR")
    if override:
        return os.path.expanduser(override)
    if os.name == "nt":
        return os.path.join(
            os.environ.get("LOCALAPPDATA", os.path.expanduser("~")), "tokka-mo"
        )
    return os.path.expanduser("~/.cache/tokka-mo")


def _cache_path():
    return os.path.join(_cache_dir(), "refdata.json")


def save_refdata_cache(data: dict) -> None:
    d = _cache_dir()
    os.makedirs(d, exist_ok=True)
    p = _cache_path()
    tmp = p + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(data, f, indent=2, sort_keys=True)
    os.replace(tmp, p)


def load_refdata_cache():
    p = _cache_path()
    if not os.path.exists(p):
        return None
    with open(p, "r", encoding="utf-8") as f:
        return json.load(f)


def is_cache_fresh(cache, *, now=None) -> bool:
    """True if cache.fetched_at is within the last 24h."""
    if not cache or not isinstance(cache, dict):
        return False
    fetched_at = cache.get("fetched_at")
    if not fetched_at or not isinstance(fetched_at, str):
        return False
    try:
        ts = _dt.datetime.fromisoformat(fetched_at.replace("Z", "+00:00"))
    except ValueError:
        return False
    if ts.tzinfo is None:
        ts = ts.replace(tzinfo=_dt.timezone.utc)
    now = now or _dt.datetime.now(_dt.timezone.utc)
    return (now - ts) < _dt.timedelta(hours=24)


def fetch_refdata(api_url: str, token: str) -> dict:
    """Download all 5 refdata sources. Returns the merged dict (no fetched_at —
    that's stamped by save_refdata_cache's caller below).
    """
    api_url = api_url.rstrip("/")
    headers = {"Authorization": f"Bearer {token}"}
    sources = {
        "portfolios": "/refdata/portfolios.json",
        "accounts": "/refdata/accounts.json",
        "counterparties": "/refdata/counterparties.json",
        "users": "/refdata/users.json",
        "tokens": "/tokens.json",
    }

    def _one(item):
        key, path = item
        status, body, _ = _http_json("GET", api_url + path, headers=headers)
        return key, path, status, body

    # Five independent read-only GETs. Fetched concurrently because doing them
    # in sequence cost ~4.5s over the VPN — long enough that a user waiting on
    # their first booking of the day felt it. Concurrent, it is ~1s.
    out = {}
    with concurrent.futures.ThreadPoolExecutor(max_workers=len(sources)) as pool:
        for key, path, status, body in pool.map(_one, sources.items()):
            if status != 200:
                raise SystemExit(
                    f"tokka-mo: refdata fetch failed for {path} "
                    f"(HTTP {status}); try `tokka-mo login` if expired"
                )
            out[key] = body
    return out


def load_refdata(*, force_refresh: bool = False) -> dict:
    """Return the refdata dict, refreshing from server if stale or missing."""
    cache = load_refdata_cache()
    if cache and not force_refresh and is_cache_fresh(cache):
        return cache
    creds = load_credentials()
    fresh = fetch_refdata(creds["api_url"], creds["token"])
    fresh["fetched_at"] = _dt.datetime.now(_dt.timezone.utc).isoformat()
    save_refdata_cache(fresh)
    return fresh


# ─────────────────────────────────────────────────────────────────
# CASHFLOW payload validation — mirrors scripts/cashflow_db.py on
# the server, plus refdata-bound enum checks using the local cache.
# ─────────────────────────────────────────────────────────────────


class ValidationError(ValueError):
    """Raised by validate_cashflow_payload for any malformed input."""


REQUIRED_CASHFLOW_FIELDS = (
    "cashflow_type", "direction", "entity", "portfolio_id",
    "portfolio_name", "counterparty", "account", "account_type",
    "asset", "amount", "trade_date", "value_date", "user_id", "status",
)
VALID_DIRECTIONS = {"INCOMING", "OUTGOING"}
VALID_STATUSES = {"PENDING", "CONFIRMED", "PROCESSED", "SETTLED", "CANCELLED"}
VALID_ACCOUNT_TYPES = {"EXCHANGE", "WALLET", "BROKER", "BANK"}
VALID_CASHFLOW_TYPES = {
    "INTER PTF FUNDING", "RETAINER FEES", "OPEX",
    "OPEX - OTHER EXPENSE", "OPEX - CONTRA ACC",
    "OTHER INCOME", "OTHER EXPENSE", "TRANSFER FEES",
    "TRADING FEES", "TRADING REWARDS",
    "STRATEGY TESTING EXPENSE", "STRATEGY TESTING RETURNED",
    "INTEREST EXPENSE", "INTEREST INCOME", "WITHHOLDING TAX",
    "LOAN", "LOAN REPAYMENT",
    "MARGIN LOAN", "MARGIN REPAYMENT", "MARGIN SETTLEMENT",
}


def _refdata_values(refdata, key, name_field="name"):
    """Pull a set of names/symbols from a refdata list. Defensive about shapes.

    The server returns:
      - accounts as {broker: [...], exchange: [...], wallet: [...], bank: [...]} — flatten.
      - tokens as {filter, generated_at, source, tokens: [...]} — unwrap.
      - everything else as a flat list of {name, ...} dicts.
    """
    raw = refdata.get(key)
    if isinstance(raw, dict):
        if key == "tokens" and isinstance(raw.get("tokens"), list):
            items = raw["tokens"]
        else:
            items = [x for v in raw.values() if isinstance(v, list) for x in v]
    else:
        items = raw or []
    out = set()
    for item in items:
        if isinstance(item, dict):
            v = item.get(name_field)
            if v:
                out.add(v)
        elif isinstance(item, str):
            out.add(item)
    return out


# Gateway sub-account ("product") support. The trade's account_id is derived
# from account + product, so a booking without one is missing the field that
# ties it to a sub-account -- which is why product is mandatory wherever the
# account offers a choice.
#
# Hierarchy for a SPOT trade on an exchange, in order. TRADING is deliberately
# NOT here: it is a distinct product even though it shares gateway code 001
# with SPOT, so an account offering only FUNDING/TRADING/FUTURES is a question,
# not a guess.
SPOT_PRODUCT_HIERARCHY = ("SPOT", "UNIFIED", "DERIVATIVES")


def refdata_account(refdata, name):
    """The full refdata record for an account NAME, or None.

    _refdata_values flattens accounts to a set of names; this keeps the dict
    so `products` / `chains` are reachable.
    """
    raw = refdata.get("accounts")
    groups = raw.values() if isinstance(raw, dict) else [raw or []]
    for group in groups:
        if not isinstance(group, list):
            continue
        for item in group:
            if isinstance(item, dict) and item.get("name") == name:
                return item
    return None


def product_options(account):
    """The sub-account values valid for this account.

    `products` for an exchange, deposit `chains` for a wallet. A broker has a
    single fixed gateway suffix and a bank has no gateway account at all, so
    both return [] and product is not required for them.
    """
    if not isinstance(account, dict):
        return []
    return list(account.get("products") or account.get("chains") or [])


def default_product(account, category=None, network=None):
    """The product to use without asking, or None when the user must decide.

    * exactly one option            -> that one
    * WALLET with a `network` given -> the chain matching it (network IS the
                                       chain for a wallet booking)
    * SPOT trade on an exchange     -> first of SPOT > UNIFIED > DERIVATIVES
    * anything else                 -> None, ask the user
    """
    opts = product_options(account)
    if not opts:
        return None
    if len(opts) == 1:
        return opts[0]
    if network:
        for o in opts:
            if str(o).strip().lower() == str(network).strip().lower():
                return o
    if str(category or "").upper() == "SPOT":
        upper = {str(o).upper(): o for o in opts}
        for want in SPOT_PRODUCT_HIERARCHY:
            if want in upper:
                return upper[want]
    return None


def validate_product(payload, refdata, category):
    """Raise ValidationError unless `product` is present and valid.

    Silent when the account offers no choice (broker/bank, or an account whose
    options refdata does not list) -- there is nothing to pick, so demanding a
    value would block a booking the gateway rule handles on its own.
    """
    account = refdata_account(refdata, payload.get("account"))
    opts = product_options(account)
    if not opts:
        return
    product = payload.get("product")
    if product is None or (isinstance(product, str) and not product.strip()):
        suggested = default_product(account, category, payload.get("network"))
        hint = f" Suggested: {suggested}." if suggested else ""
        raise ValidationError(
            f"required field missing or empty: product "
            f"(account {payload.get('account')!r} offers {opts}).{hint}"
        )
    if str(product).upper() not in {str(o).upper() for o in opts}:
        raise ValidationError(
            f"product {product!r} is not valid for account "
            f"{payload.get('account')!r} -- it offers {opts}"
        )


def _refdata_portfolio_ids(refdata):
    """{portfolio_number: name} so we can validate id + name match together.

    The payload's `portfolio_id` field carries the user-facing portfolio
    NUMBER (e.g. 8000, 8006) — that's what the server matches on. The cache
    row's `number` field holds that; `id` is just the internal DB row id.
    Fall back to `id` only if `number` is absent.
    """
    out = {}
    for p in refdata.get("portfolios") or []:
        if isinstance(p, dict) and "name" in p:
            key = p.get("number")
            if key is None:
                key = p.get("id")
            if key is not None:
                out[key] = p["name"]
    return out


def _suggest(value, choices, n=3):
    """Return n closest choices as a string hint.

    Case matters here more than it looks. Refdata names are upper case and the
    values we are asked about are whatever the user typed, so a case-sensitive
    difflib scored 'native' against 'NATIVE CORE' at nearly zero and offered
    'LiFi, ZKSYNC, ZETA' instead — three names sharing no meaning with the
    input, from a list that contained the right answer.

    Anything containing the input comes first, since a partial name is how
    people actually abbreviate ('native' -> NATIVE CORE), then closest spelling.
    """
    import difflib
    if not choices:
        return ""
    want = str(value).strip().lower()
    if not want:
        return ""
    names = [str(c) for c in choices]
    lower = {n_: n_.lower() for n_ in names}
    contains = [n_ for n_ in names if want in lower[n_]]
    contains.sort(key=lambda n_: (len(n_), n_))          # tightest fit first
    close = difflib.get_close_matches(want, [lower[n_] for n_ in names],
                                      n=n, cutoff=0.0)
    by_lower = {}
    for n_ in names:
        by_lower.setdefault(lower[n_], n_)
    matches = contains + [by_lower[c] for c in close if by_lower.get(c) not in contains]
    matches = matches[:n]
    return f" Did you mean: {', '.join(matches)}?" if matches else ""


def validate_cashflow_payload(payload, refdata) -> None:
    """Raise ValidationError on any rule break. Otherwise return None."""
    if not isinstance(payload, dict):
        raise ValidationError("payload must be an object")

    for field in REQUIRED_CASHFLOW_FIELDS:
        v = payload.get(field)
        if v is None or (isinstance(v, str) and not v.strip()):
            raise ValidationError(f"required field missing or empty: {field}")

    # Enum checks
    if payload["direction"] not in VALID_DIRECTIONS:
        raise ValidationError(
            f"direction must be one of {sorted(VALID_DIRECTIONS)}, got {payload['direction']!r}"
        )
    if payload["status"] not in VALID_STATUSES:
        raise ValidationError(
            f"status must be one of {sorted(VALID_STATUSES)}, got {payload['status']!r}"
        )
    if payload["account_type"] not in VALID_ACCOUNT_TYPES:
        raise ValidationError(
            f"account_type must be one of {sorted(VALID_ACCOUNT_TYPES)}, got {payload['account_type']!r}"
        )
    if payload["cashflow_type"] not in VALID_CASHFLOW_TYPES:
        raise ValidationError(
            f"cashflow_type must be one of {sorted(VALID_CASHFLOW_TYPES)}, "
            f"got {payload['cashflow_type']!r}"
        )

    # Amount
    try:
        amt = float(str(payload["amount"]))
    except (TypeError, ValueError):
        raise ValidationError(f"amount must be numeric, got {payload['amount']!r}")
    if abs(amt) == 0:
        raise ValidationError("amount must be non-zero")

    # Dates
    for d in ("trade_date", "value_date"):
        try:
            _dt.datetime.fromisoformat(payload[d].replace("Z", "+00:00"))
        except (ValueError, AttributeError):
            raise ValidationError(
                f"{d} must be ISO 8601 with timezone, got {payload[d]!r}"
            )

    # Refdata-bound fields
    ports = _refdata_portfolio_ids(refdata)
    if payload["portfolio_id"] not in ports:
        suggest = _suggest(payload["portfolio_id"], sorted(ports.keys()))
        raise ValidationError(
            f"portfolio_id {payload['portfolio_id']!r} not in refdata.{suggest} "
            f"Run `tokka-mo refdata refresh` if your cache is stale."
        )
    expected_name = ports[payload["portfolio_id"]]
    if payload["portfolio_name"] != expected_name:
        raise ValidationError(
            f"portfolio_name {payload['portfolio_name']!r} doesn't match "
            f"portfolio_id {payload['portfolio_id']} (expected {expected_name!r})"
        )

    # INTER PTF FUNDING: counterparty is the *other* portfolio's number as a
    # string of digits, not a named counterparty (server enforces this).
    if payload["cashflow_type"] == "INTER PTF FUNDING":
        cp = str(payload["counterparty"])
        if not cp.isdigit():
            raise ValidationError(
                f"counterparty for INTER PTF FUNDING must be a portfolio "
                f"number (string of digits), got {payload['counterparty']!r}"
            )
        if int(cp) not in ports:
            raise ValidationError(
                f"counterparty portfolio {cp!r} not in refdata."
                f"{_suggest(cp, sorted(str(k) for k in ports.keys()))}"
            )
    else:
        counterparties = _refdata_values(refdata, "counterparties")
        if payload["counterparty"] not in counterparties:
            raise ValidationError(
                f"counterparty {payload['counterparty']!r} not in refdata."
                f"{_suggest(payload['counterparty'], counterparties)}"
            )

    accounts = _refdata_values(refdata, "accounts")
    if payload["account"] not in accounts:
        raise ValidationError(
            f"account {payload['account']!r} not in refdata."
            f"{_suggest(payload['account'], accounts)}"
        )
    validate_product(payload, refdata, "CASHFLOW")

    tokens = _refdata_values(refdata, "tokens", name_field="symbol")
    if payload["asset"] not in tokens:
        raise ValidationError(
            f"asset {payload['asset']!r} not in refdata."
            f"{_suggest(payload['asset'], tokens)}"
        )


# ─────────────────────────────────────────────────────────────────
# SPOT validation. Mirrors scripts/spot_db._validate_one (the server's
# source of truth) and adds the refdata-membership checks the server
# can't do from the cache. SPOT leaves account/account_type/counterparty
# optional — they are validated only when present.
# ─────────────────────────────────────────────────────────────────

REQUIRED_SPOT_FIELDS = (
    "direction", "entity", "portfolio_id", "portfolio_name",
    "base_asset", "base_amount", "quote_asset", "quote_amount", "price",
    "trade_date", "value_date", "user_id", "status",
)
VALID_SPOT_DIRECTIONS = {"LONG", "SHORT"}
# Relative tolerance for the base x price == quote identity (float noise).
SPOT_PRICE_TOLERANCE = 1e-6


def _parse_numeric(value, field):
    try:
        return float(str(value))
    except (TypeError, ValueError):
        raise ValidationError(f"{field} must be numeric, got {value!r}")


def validate_spot_payload(payload, refdata) -> None:
    """Raise ValidationError on any rule break. Otherwise return None."""
    if not isinstance(payload, dict):
        raise ValidationError("payload must be an object")

    for field in REQUIRED_SPOT_FIELDS:
        v = payload.get(field)
        if v is None or (isinstance(v, str) and not v.strip()):
            raise ValidationError(f"required field missing or empty: {field}")

    if payload["direction"] not in VALID_SPOT_DIRECTIONS:
        raise ValidationError(
            f"direction must be one of {sorted(VALID_SPOT_DIRECTIONS)}, "
            f"got {payload['direction']!r}"
        )
    if payload["status"] not in VALID_STATUSES:
        raise ValidationError(
            f"status must be one of {sorted(VALID_STATUSES)}, got {payload['status']!r}"
        )

    base_amount = _parse_numeric(payload["base_amount"], "base_amount")
    quote_amount = _parse_numeric(payload["quote_amount"], "quote_amount")
    price = _parse_numeric(payload["price"], "price")
    fee_amount = payload.get("fee_amount")
    if fee_amount not in (None, "", 0):
        _parse_numeric(fee_amount, "fee_amount")

    if payload["base_asset"] == payload["quote_asset"]:
        raise ValidationError(
            f"base_asset and quote_asset must differ, both = {payload['base_asset']!r}"
        )

    try:
        pid = int(payload["portfolio_id"])
    except (TypeError, ValueError):
        raise ValidationError(
            f"portfolio_id must be integer, got {payload['portfolio_id']!r}"
        )

    # base x price == quote identity
    expected_quote = base_amount * price
    if expected_quote == 0:
        if quote_amount != 0:
            raise ValidationError(
                f"base x price ({base_amount} x {price} = 0) "
                f"must equal quote_amount ({quote_amount})"
            )
    else:
        rel = abs(expected_quote - quote_amount) / abs(expected_quote)
        if rel > SPOT_PRICE_TOLERANCE:
            raise ValidationError(
                f"base x price ({base_amount} x {price} = {expected_quote}) "
                f"must equal quote_amount ({quote_amount})"
            )

    # Refdata-bound fields
    ports = _refdata_portfolio_ids(refdata)
    if pid not in ports:
        suggest = _suggest(pid, sorted(ports.keys()))
        raise ValidationError(
            f"portfolio_id {pid!r} not in refdata.{suggest} "
            f"Run `tokka-mo refdata refresh` if your cache is stale."
        )
    expected_name = ports[pid]
    if payload["portfolio_name"] != expected_name:
        raise ValidationError(
            f"portfolio_name {payload['portfolio_name']!r} doesn't match "
            f"portfolio_id {pid} (expected {expected_name!r})"
        )

    tokens = _refdata_values(refdata, "tokens", name_field="symbol")
    for fld in ("base_asset", "quote_asset"):
        if payload[fld] not in tokens:
            raise ValidationError(
                f"{fld} {payload[fld]!r} not in refdata."
                f"{_suggest(payload[fld], tokens)}"
            )
    fee_asset = payload.get("fee_asset")
    if fee_asset and fee_asset not in tokens:
        raise ValidationError(
            f"fee_asset {fee_asset!r} not in refdata.{_suggest(fee_asset, tokens)}"
        )

    # account is optional for SPOT; validate it (and account_type) only when set.
    account = payload.get("account")
    if account:
        accounts = _refdata_values(refdata, "accounts")
        if account not in accounts:
            raise ValidationError(
                f"account {account!r} not in refdata.{_suggest(account, accounts)}"
            )
        acct_type = payload.get("account_type")
        if acct_type not in VALID_ACCOUNT_TYPES:
            raise ValidationError(
                f"account_type must be one of {sorted(VALID_ACCOUNT_TYPES)}, "
                f"got {acct_type!r}"
            )
        validate_product(payload, refdata, "SPOT")

    # counterparty is optional for SPOT; when set it's a NAMED counterparty
    # (unlike INTER PTF FUNDING, which uses a portfolio-number string).
    cp = payload.get("counterparty")
    if cp:
        counterparties = _refdata_values(refdata, "counterparties")
        if cp not in counterparties:
            raise ValidationError(
                f"counterparty {cp!r} not in refdata.{_suggest(cp, counterparties)}"
            )


VALID_CATEGORIES = {"CASHFLOW", "SPOT"}


def infer_category(payload):
    """Best-effort category from payload shape when none is supplied."""
    if isinstance(payload, dict):
        if payload.get("cashflow_type"):
            return "CASHFLOW"
        if payload.get("base_asset") or payload.get("quote_asset"):
            return "SPOT"
    return "CASHFLOW"


def validate(category, payload, refdata) -> None:
    """Dispatch to the category-specific validator."""
    if category == "CASHFLOW":
        validate_cashflow_payload(payload, refdata)
    elif category == "SPOT":
        validate_spot_payload(payload, refdata)
    else:
        raise ValidationError(f"unknown category: {category!r}")


# ─────────────────────────────────────────────────────────────────
# HTTP helpers — stdlib urllib only.
#
# Two helpers:
#   _http_json(url, ...)   — generic JSON POST/GET/DELETE, returns
#                            (status, body_or_dict, response_headers).
#   resolve_api_url(args)  — order: --api-url, $TOKKA_MO_API_URL,
#                            saved creds.api_url, else error.
# ─────────────────────────────────────────────────────────────────
import urllib.request
import urllib.error


def resolve_api_url(args) -> str:
    """Return the server base URL, raise on missing."""
    candidates = []
    if getattr(args, "login_api_url", None):
        candidates.append(args.login_api_url)
    if getattr(args, "api_url", None):
        candidates.append(args.api_url)
    if not candidates:
        try:
            candidates.append(load_credentials().get("api_url"))
        except CredsMissing:
            pass
    for c in candidates:
        if c:
            return c.rstrip("/")
    raise SystemExit(
        "tokka-mo: no API URL set. Use --api-url, $TOKKA_MO_API_URL, "
        "or run `tokka-mo login --api-url <url>` first."
    )


def _http_json(method, url, *, body=None, headers=None, timeout=10):
    """Send a JSON request. Returns (status, parsed_body_or_text, response_headers)."""
    data = None
    h = {"Accept": "application/json"}
    if headers:
        h.update(headers)
    if body is not None:
        data = json.dumps(body).encode("utf-8")
        h["Content-Type"] = "application/json"
    req = urllib.request.Request(url, data=data, method=method, headers=h)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            raw = resp.read().decode("utf-8")
            try:
                parsed = json.loads(raw) if raw else None
            except json.JSONDecodeError:
                parsed = raw
            return resp.status, parsed, dict(resp.getheaders())
    except urllib.error.HTTPError as e:
        raw = e.read().decode("utf-8", errors="replace")
        try:
            parsed = json.loads(raw) if raw else None
        except json.JSONDecodeError:
            parsed = raw
        return e.code, parsed, dict(e.headers or {})
    except urllib.error.URLError as e:
        raise SystemExit(f"tokka-mo: cannot reach {url}: {e.reason}")


def _authed_request(method, path, *, body=None, timeout=10):
    """Send an authenticated request using the saved creds.
    Returns (status, parsed_body, response_headers). Caller handles 401.
    """
    creds = load_credentials()
    url = creds["api_url"].rstrip("/") + path
    headers = {"Authorization": f"Bearer {creds['token']}"}
    return _http_json(method, url, body=body, headers=headers, timeout=timeout)


# ─────────────────────────────────────────────────────────────────
# Commands
# ─────────────────────────────────────────────────────────────────
import getpass


def cmd_login(args) -> int:
    """Two-step login:
      1. POST /api/auth/login -> Set-Cookie: sid=<session>
      2. POST /api/tokens with that cookie -> token plaintext (returned ONCE)
      3. Save token; discard cookie (we never use cookies again for this CLI).
    """
    api_url = resolve_api_url(args)
    if getattr(args, "non_interactive", False):
        # CI / smoke path: read two lines from stdin (username, password)
        username = sys.stdin.readline().rstrip("\r\n")
        password = sys.stdin.readline().rstrip("\r\n")
    else:
        username = input("Username: ").strip()
        if not username:
            print("login aborted: empty username", file=sys.stderr)
            return 2
        password = getpass.getpass("Password: ")
    if not username or not password:
        print("login aborted: empty username or password", file=sys.stderr)
        return 2

    # Step 1: cookie login
    status, body, headers = _http_json(
        "POST", f"{api_url}/api/auth/login",
        body={"username": username, "password": password},
    )
    if status != 200 or not (isinstance(body, dict) and body.get("ok")):
        msg = (isinstance(body, dict) and body.get("error")) or f"HTTP {status}"
        print(f"Login failed: {msg}", file=sys.stderr)
        return 3
    set_cookie = headers.get("Set-Cookie", "") or headers.get("set-cookie", "")
    sid = _extract_sid(set_cookie)
    if not sid:
        print("Login failed: server did not return a session cookie", file=sys.stderr)
        return 3

    # Step 2: mint a long-lived API token
    token_name = f"tokka-mo CLI ({_hostname()})"
    status, body, _ = _http_json(
        "POST", f"{api_url}/api/tokens",
        body={"name": token_name, "expires_in_days": 90},
        headers={"Cookie": f"sid={sid}"},
    )
    if status != 200 or not (isinstance(body, dict) and body.get("ok")):
        msg = (isinstance(body, dict) and body.get("error")) or f"HTTP {status}"
        print(f"Token mint failed: {msg}", file=sys.stderr)
        return 4
    token = body.get("token")
    prefix = body.get("prefix")
    token_id = body.get("id")
    expires_at = body.get("expires_at")
    if not token:
        print("Token mint failed: server did not return a token plaintext", file=sys.stderr)
        return 4

    # Step 3: save; we never need the session cookie again. The server
    # cleans up idle sessions, so no explicit logout is required for the
    # cookie. (Bearer tokens are separately revocable via `tokka-mo logout`.)
    save_credentials({
        "api_url": api_url,
        "username": username,
        "token": token,
        "prefix": prefix,
        "token_id": token_id,
        "expires_at": expires_at,
    })
    print(f"Logged in as {username}. Token {prefix}… expires {expires_at}.")
    return 0


def _extract_sid(set_cookie_header):
    """Parse 'sid=abc; HttpOnly; ...' -> 'abc'. Empty string -> None."""
    if not set_cookie_header:
        return None
    for part in set_cookie_header.split(";"):
        part = part.strip()
        if part.startswith("sid="):
            v = part[4:]
            return v or None
    return None


def _hostname():
    import socket
    try:
        return socket.gethostname()
    except Exception:
        return "unknown-host"


def cmd_whoami(args) -> int:
    try:
        creds = load_credentials()
    except CredsMissing:
        print("not logged in; run: tokka-mo login", file=sys.stderr)
        return 4
    status, body, _ = _authed_request("GET", "/api/auth/me")
    if status == 401:
        print("Token rejected — run: tokka-mo login", file=sys.stderr)
        return 4
    if status != 200 or not (isinstance(body, dict) and body.get("ok")):
        msg = (isinstance(body, dict) and body.get("error")) or f"HTTP {status}"
        print(f"whoami failed: {msg}", file=sys.stderr)
        return 5
    user = body.get("user") or {}
    print(
        f"{user.get('username','?')} · {user.get('role','?')} · "
        f"token {creds['prefix']}… (expires {creds['expires_at']})"
    )
    return 0


import uuid as _uuid


def _read_stdin_json():
    raw = sys.stdin.read().strip()
    if not raw:
        raise SystemExit("tokka-mo: no JSON on stdin (use a heredoc or pipe a file)")
    try:
        return json.loads(raw)
    except json.JSONDecodeError as e:
        raise SystemExit(f"tokka-mo: invalid JSON on stdin: {e}")


def cmd_book(args) -> int:
    payload = _read_stdin_json()

    category = getattr(args, "category", None) or infer_category(payload)
    if category not in VALID_CATEGORIES:
        print(
            f"tokka-mo: --category must be one of {sorted(VALID_CATEGORIES)}",
            file=sys.stderr,
        )
        return 3

    # Idempotency key
    crid = args.client_request_id or str(_uuid.uuid4())
    try:
        _uuid.UUID(crid)
    except (ValueError, AttributeError):
        print(f"tokka-mo: --client-request-id {crid!r} is not a valid UUID", file=sys.stderr)
        return 3

    # Local validation against cached refdata
    try:
        refdata = load_refdata()
    except CredsMissing:
        print("not logged in; run: tokka-mo login", file=sys.stderr)
        return 4
    try:
        validate(category, payload, refdata)
    except ValidationError as e:
        print(f"validation failed: {e}", file=sys.stderr)
        return 3

    # POST /api/bookings/draft
    status, body, _ = _authed_request(
        "POST", "/api/bookings/draft",
        body={
            "category": category,
            "payload": payload,
            "client_request_id": crid,
        },
    )
    if status == 401:
        print("Token rejected — run: tokka-mo login", file=sys.stderr)
        return 4
    if status not in (200, 201) or not (isinstance(body, dict) and body.get("ok")):
        msg = (isinstance(body, dict) and body.get("error")) or f"HTTP {status}"
        print(f"server rejected draft: {msg}", file=sys.stderr)
        return 3
    row = body.get("row") or {}
    deduped = body.get("deduped", False)
    creds = load_credentials()
    review_url = f"{creds['api_url']}/pending"
    if deduped:
        print(f"Draft #{row.get('id')} already existed (idempotent retry). Review at {review_url}")
    else:
        print(f"Draft #{row.get('id')} created (PENDING_REVIEW). Review at {review_url}")
    return 0


REQUIRED_LOAN_FIELDS = (
    "direction", "loan_type", "entity", "portfolio_id", "portfolio_name",
    "counterparty", "principal_asset", "principal_amount", "interest_asset",
    "interest_type", "trade_date", "user_id", "status",
)
VALID_LOAN_DIRECTIONS = {"BORROW", "LEND"}
VALID_LOAN_TYPES = {"VIP LOAN", "INTERNAL", "EXTERNAL", "DEFI LENDING"}
VALID_INTEREST_TYPES = {"FIXED", "FLOATING"}
VALID_LOAN_STATUSES = {"LIVE", "MATURED", "CANCELLED"}


def validate_loan_payload(payload, refdata):
    """Local checks before a loan is written. Mirrors loan_db, with one
    addition: `counterparty` is REQUIRED here even though the server's
    validator does not enforce it. A loan with no counterparty names nobody
    to owe, and nothing downstream can repair that after the fact.
    """
    if not isinstance(payload, dict):
        raise ValidationError("loan payload must be a JSON object")
    for field in REQUIRED_LOAN_FIELDS:
        v = payload.get(field)
        if v is None or (isinstance(v, str) and not v.strip()):
            raise ValidationError(f"required field missing or empty: {field}")

    for field, valid in (("direction", VALID_LOAN_DIRECTIONS),
                         ("loan_type", VALID_LOAN_TYPES),
                         ("interest_type", VALID_INTEREST_TYPES),
                         ("status", VALID_LOAN_STATUSES)):
        if payload[field] not in valid:
            raise ValidationError(
                f"{field} must be one of {sorted(valid)}, got {payload[field]!r}")

    try:
        amount = float(str(payload["principal_amount"]))
    except ValueError:
        raise ValidationError(
            f"principal_amount must be numeric, got {payload['principal_amount']!r}")
    # Checked outside the try: ValidationError subclasses ValueError, so raising
    # it inside would be swallowed and reported as "not numeric", which sends
    # the operator looking for the wrong problem.
    if amount <= 0:
        raise ValidationError(
            f"principal_amount must be greater than zero, got {amount}")

    try:
        _dt.datetime.fromisoformat(str(payload["trade_date"]).replace("Z", "+00:00"))
    except ValueError:
        raise ValidationError(
            f"trade_date must be ISO 8601 with timezone, got {payload['trade_date']!r}")

    ports = _refdata_portfolio_ids(refdata)
    if payload["portfolio_id"] not in ports:
        suggest = _suggest(payload["portfolio_id"], sorted(ports.keys()))
        raise ValidationError(
            f"portfolio_id {payload['portfolio_id']!r} not in refdata.{suggest}")
    if payload["portfolio_name"] != ports[payload["portfolio_id"]]:
        raise ValidationError(
            f"portfolio_name {payload['portfolio_name']!r} doesn't match "
            f"portfolio_id {payload['portfolio_id']} "
            f"(expected {ports[payload['portfolio_id']]!r})")

    cptys = _refdata_values(refdata, "counterparties")
    if cptys and payload["counterparty"] not in cptys:
        suggest = _suggest(payload["counterparty"], sorted(cptys))
        raise ValidationError(
            f"counterparty {payload['counterparty']!r} not in refdata.{suggest}")

    tokens = _refdata_values(refdata, "tokens", name_field="symbol")
    for field in ("principal_asset", "interest_asset"):
        if tokens and payload[field] not in tokens:
            suggest = _suggest(payload[field], sorted(tokens))
            raise ValidationError(f"{field} {payload[field]!r} not in refdata.{suggest}")


def cmd_loan_list(args) -> int:
    """List loan agreements, so an MCF can be tagged to the right MLA.

    Read-only. Defaults to LIVE, because a cashflow can only be mapped to a
    live loan -- offering a matured or cancelled one as a candidate would
    produce a mapping the server rejects.
    """
    status, body, _ = _authed_request("GET", "/api/loan/recent?limit=2000")
    if status == 401:
        print("Token rejected — run: tokka-mo login", file=sys.stderr)
        return 4
    if status != 200 or not (isinstance(body, dict) and body.get("ok")):
        msg = (isinstance(body, dict) and body.get("error")) or f"HTTP {status}"
        print(f"could not read loans: {msg}", file=sys.stderr)
        return 3

    rows = body.get("rows") or []
    want_status = (getattr(args, "status", None) or "LIVE").upper()
    if want_status != "ALL":
        rows = [r for r in rows if (r.get("status") or "") == want_status]
    if getattr(args, "counterparty", None):
        needle = args.counterparty.upper()
        rows = [r for r in rows if needle in (r.get("counterparty") or "").upper()]
    if getattr(args, "asset", None):
        needle = args.asset.upper()
        rows = [r for r in rows if (r.get("principal_asset") or "").upper() == needle]
    if getattr(args, "portfolio", None):
        rows = [r for r in rows if str(r.get("portfolio_id")) == str(args.portfolio)]

    if not rows:
        print("No matching loans. Do NOT invent a deal_ref — ask the operator "
              "whether the facility needs creating.")
        return 0

    rows.sort(key=lambda r: str(r.get("trade_date") or ""), reverse=True)
    print(f"{len(rows)} matching loan(s):")
    for r in rows[:40]:
        print("  %-12s %-10s %-28s %18s %-8s %6s%%  %-9s %s" % (
            r.get("deal_ref"), str(r.get("trade_date"))[:10],
            str(r.get("counterparty") or "-")[:28], r.get("principal_amount"),
            r.get("principal_asset"), r.get("interest_rate_pa_pct"),
            r.get("status"), r.get("loan_type")))
    if len(rows) > 40:
        print(f"  ... and {len(rows) - 40} more; narrow with --counterparty/--asset")
    return 0


def cmd_loan_open(args) -> int:
    """Create a master loan agreement (MLA). JSON payload on stdin.

    UNLIKE `book`, this writes to the book IMMEDIATELY. There is no draft and
    no approval step: the server exposes only a direct /api/loan/insert, so a
    loan created here is live the moment it returns. Say so to the operator
    before calling it, and never call it to "see what happens".
    """
    payload = _read_stdin_json()

    # A facility with no stated rate is a zero-rate facility, and the desk
    # stores that as a literal 0 (101 of 116 live loans). Omitting the field
    # would leave a NULL, which renders as a blank rate rather than a zero one
    # and reads as "unknown". Normalise it here and say so, so the assumption
    # is visible rather than silent. Maturity needs no equivalent: absent
    # already means open term, which is how every live facility is booked.
    if isinstance(payload, dict) and payload.get("interest_rate_pa_pct") in (None, ""):
        payload["interest_rate_pa_pct"] = "0"
        print("note: no interest rate given — booking at 0% (open-term unless "
              "maturity_date was set)", file=sys.stderr)

    try:
        refdata = load_refdata()
    except CredsMissing:
        print("not logged in; run: tokka-mo login", file=sys.stderr)
        return 4
    try:
        validate_loan_payload(payload, refdata)
    except ValidationError as e:
        print(f"validation failed: {e}", file=sys.stderr)
        return 3

    if getattr(args, "dry_run", False):
        print("Payload valid. NOT sent (--dry-run). Remove --dry-run and add "
              "--yes to create the loan for real.")
        return 0

    if not getattr(args, "yes", False):
        print("refusing to create a loan without --yes: this writes to the book "
              "immediately, with no review step. Use --dry-run to validate only.",
              file=sys.stderr)
        return 3

    status, body, _ = _authed_request("POST", "/api/loan/insert", body=payload)
    if status == 401:
        print("Token rejected — run: tokka-mo login", file=sys.stderr)
        return 4
    if status not in (200, 201) or not (isinstance(body, dict) and body.get("ok")):
        msg = (isinstance(body, dict) and body.get("error")) or f"HTTP {status}"
        print(f"server rejected loan: {msg}", file=sys.stderr)
        return 3

    # The route answers {"rows": [...]}, not {"row": {...}}.
    rows = body.get("rows") or []
    ref = (rows[0] or {}).get("deal_ref") if rows else None
    if not ref:
        # The loan very likely exists; we simply cannot name it. Say so loudly
        # rather than returning a success the caller would tag a cashflow to.
        print("Loan was accepted but no deal_ref came back. It may exist — check "
              "TMS before creating another.", file=sys.stderr)
        return 3
    print(f"Loan {ref} created and LIVE. "
          f"Tag cashflows to it with _meta.loan_deal_refs = [\"{ref}\"].")
    return 0


def cmd_book_batch(args) -> int:
    body = _read_stdin_json()
    if not isinstance(body, dict) or not isinstance(body.get("trades"), list):
        print("tokka-mo: stdin must be {\"trades\": [...]}", file=sys.stderr)
        return 3
    trades = body["trades"]
    if not trades:
        print("tokka-mo: trades list is empty", file=sys.stderr)
        return 3
    if len(trades) > 50:
        print(f"tokka-mo: batch too large ({len(trades)} > 50)", file=sys.stderr)
        return 3

    # Load refdata once
    try:
        refdata = load_refdata()
    except CredsMissing:
        print("not logged in; run: tokka-mo login", file=sys.stderr)
        return 4

    # Local validation
    prepared = []
    seen_crids = set()
    for i, t in enumerate(trades):
        if not isinstance(t, dict):
            print(f"trade {i}: not an object", file=sys.stderr)
            return 3
        payload = t.get("payload") or t  # allow bare payloads
        category = t.get("category") or infer_category(payload)
        if category not in VALID_CATEGORIES:
            print(f"trade {i}: invalid category {category!r}", file=sys.stderr)
            return 3
        crid = t.get("client_request_id") or str(_uuid.uuid4())
        try:
            _uuid.UUID(crid)
        except (ValueError, AttributeError):
            print(f"trade {i}: invalid client_request_id {crid!r}", file=sys.stderr)
            return 3
        if crid in seen_crids:
            print(f"trade {i}: duplicate client_request_id in batch: {crid}", file=sys.stderr)
            return 3
        seen_crids.add(crid)
        try:
            validate(category, payload, refdata)
        except ValidationError as e:
            print(f"trade {i} validation failed: {e}", file=sys.stderr)
            return 3
        prepared.append({
            "category": category,
            "payload": payload,
            "client_request_id": crid,
        })

    # POST batch
    status, body, _ = _authed_request(
        "POST", "/api/bookings/draft/batch",
        body={"trades": prepared},
    )
    if status == 401:
        print("Token rejected — run: tokka-mo login", file=sys.stderr)
        return 4
    if status not in (200, 201) or not (isinstance(body, dict) and body.get("ok")):
        msg = (isinstance(body, dict) and body.get("error")) or f"HTTP {status}"
        print(f"server rejected batch: {msg}", file=sys.stderr)
        return 3
    batch_id = body.get("batch_id")
    rows = body.get("rows") or []
    ids = [str(r.get("id")) for r in rows]
    creds = load_credentials()
    print(
        f"Batch {batch_id} · {len(rows)} drafts created "
        f"(#{', #'.join(ids)}). Review at {creds['api_url']}/pending"
    )
    return 0


def _summarize_payload(p):
    """One-line cashflow summary for the text table."""
    if not isinstance(p, dict):
        return "(empty)"
    parts = [
        p.get("cashflow_type"), p.get("direction"),
        p.get("amount"), p.get("asset"),
        p.get("counterparty"), p.get("network"),
    ]
    return " · ".join(str(x) for x in parts if x)


def cmd_drafts_list(args) -> int:
    qs = []
    if args.status:
        qs.append(f"status={args.status}")
    if args.batch_id:
        qs.append(f"batch_id={args.batch_id}")
    path = "/api/bookings/drafts" + (("?" + "&".join(qs)) if qs else "")
    status, body, _ = _authed_request("GET", path)
    if status == 401:
        print("Token rejected — run: tokka-mo login", file=sys.stderr)
        return 4
    if status != 200 or not (isinstance(body, dict) and body.get("ok")):
        msg = (isinstance(body, dict) and body.get("error")) or f"HTTP {status}"
        print(f"list failed: {msg}", file=sys.stderr)
        return 5
    drafts = body.get("drafts") or []
    if not drafts:
        print("(no drafts)")
        return 0
    # Compact text table
    print(f"{'ID':>5}  {'STATUS':<14}  {'CAT':<8}  {'CREATED':<19}  SUMMARY")
    print("-" * 100)
    for d in drafts:
        created = (d.get("created_at") or "")[:19].replace("T", " ")
        print(
            f"{d.get('id'):>5}  "
            f"{(d.get('status') or '')[:14]:<14}  "
            f"{(d.get('category') or '')[:8]:<8}  "
            f"{created:<19}  "
            f"{_summarize_payload(d.get('payload'))}"
        )
    return 0


def cmd_refdata_refresh(args) -> int:
    try:
        load_credentials()
    except CredsMissing:
        print("not logged in; run: tokka-mo login", file=sys.stderr)
        return 4
    data = load_refdata(force_refresh=True)
    print(
        f"portfolios: {len(data.get('portfolios') or [])} · "
        f"accounts: {len(data.get('accounts') or [])} · "
        f"counterparties: {len(data.get('counterparties') or [])} · "
        f"users: {len(data.get('users') or [])} · "
        f"tokens: {len(data.get('tokens') or [])} · "
        f"fetched {data['fetched_at']}"
    )
    return 0


def cmd_logout(args) -> int:
    try:
        creds = load_credentials()
    except CredsMissing:
        print("not logged in", file=sys.stderr)
        return 0
    token_id = creds.get("token_id")
    if token_id is not None:
        status, body, _ = _authed_request("DELETE", f"/api/tokens/{token_id}")
        # 204 (no content) is the success path; 401/404 also acceptable
        # (token already revoked or expired). We always clear local creds.
        if status not in (200, 204, 401, 404):
            msg = (isinstance(body, dict) and body.get("error")) or f"HTTP {status}"
            print(f"logout: server returned {msg}; clearing local creds anyway",
                  file=sys.stderr)
    clear_credentials()
    print("Logged out.")
    return 0


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="tokka-mo",
        description="Tokka Labs Middle Office CLI for Claude Code.",
    )
    p.add_argument("--version", action="version", version=f"tokka-mo {VERSION}")
    p.add_argument(
        "--api-url",
        default=os.environ.get("TOKKA_MO_API_URL"),
        help=(
            "Base URL of the MO server (e.g. https://sg-tms.internal.tokkalabs.com for PROD, https://test-jp-tms.internal.tokkalabs.com for UAT; both require Tokka VPN). "
            "Default: $TOKKA_MO_API_URL, or the saved value from `tokka-mo login`."
        ),
    )
    sub = p.add_subparsers(dest="cmd", required=True)

    # login
    sp = sub.add_parser("login", help="Interactive login -> mint API token -> save")
    sp.add_argument("--api-url", dest="login_api_url", default=None,
                    help="Server base URL to save with the credentials")
    sp.add_argument(
        "--non-interactive", action="store_true",
        help="Read username and password from stdin (two lines). For CI / smoke.",
    )
    sp.set_defaults(func=cmd_login)

    # logout
    sp = sub.add_parser("logout", help="Revoke current token and clear local creds")
    sp.set_defaults(func=cmd_logout)

    # whoami
    sp = sub.add_parser("whoami", help="Show the authenticated user")
    sp.set_defaults(func=cmd_whoami)

    # refdata refresh
    sp = sub.add_parser("refdata", help="Manage local refdata cache")
    refdata_sub = sp.add_subparsers(dest="refdata_cmd", required=True)
    rsp = refdata_sub.add_parser("refresh", help="Pull /refdata/*.json into the cache")
    rsp.set_defaults(func=cmd_refdata_refresh)

    # book (single)
    sp = sub.add_parser(
        "book",
        help="POST one CASHFLOW or SPOT draft. JSON payload on stdin.",
    )
    sp.add_argument("--category", choices=("CASHFLOW", "SPOT"), default=None,
                    help="Booking category. Inferred from the payload if omitted.")
    sp.add_argument("--client-request-id", default=None,
                    help="Idempotency UUID. Auto-generated if omitted.")
    sp.set_defaults(func=cmd_book)

    # book-batch (atomic N)
    sp = sub.add_parser(
        "book-batch",
        help=(
            "POST N drafts atomically. JSON on stdin: {trades: [...]}. "
            "Each trade may set its own category (CASHFLOW or SPOT)."
        ),
    )
    sp.set_defaults(func=cmd_book_batch)

    # loan-list (read-only lookup, for tagging cashflows to the right MLA)
    sp = sub.add_parser(
        "loan-list",
        help="List loan agreements (MLAs) so a cashflow can be tagged correctly.",
    )
    sp.add_argument("--counterparty", default=None, help="Substring match.")
    sp.add_argument("--asset", default=None, help="Exact principal asset ticker.")
    sp.add_argument("--portfolio", default=None, help="Portfolio number.")
    sp.add_argument("--status", default="LIVE",
                    choices=("LIVE", "MATURED", "CANCELLED", "ALL"),
                    help="Default LIVE — only live loans can be mapped to.")
    sp.set_defaults(func=cmd_loan_list)

    # loan-open (NOT a draft -- writes immediately)
    sp = sub.add_parser(
        "loan-open",
        help=("Create a master loan agreement (MLA). JSON payload on stdin. "
              "WRITES IMMEDIATELY -- there is no draft or approval step."),
    )
    sp.add_argument("--yes", action="store_true",
                    help="Required. Confirms you understand this is not a draft.")
    sp.add_argument("--dry-run", action="store_true", dest="dry_run",
                    help="Validate the payload and send nothing. Use this first.")
    sp.set_defaults(func=cmd_loan_open)

    # drafts list
    sp = sub.add_parser("drafts", help="Inspect your drafts")
    drafts_sub = sp.add_subparsers(dest="drafts_cmd", required=True)
    dlp = drafts_sub.add_parser("list", help="List your drafts (text table)")
    dlp.add_argument("--status", choices=("PENDING_REVIEW", "APPROVED", "REJECTED"),
                     default=None)
    dlp.add_argument("--batch", dest="batch_id", default=None,
                     help="Filter to a single batch_id (UUID)")
    dlp.set_defaults(func=cmd_drafts_list)

    return p


def main(argv=None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    return args.func(args) or 0


if __name__ == "__main__":
    sys.exit(main())
