# Trade-booking environment template.
#
# Two ways to provide credentials:
#   1. Environment variables (preferred for k8s / CI).
#      Each script tries env vars first — see the names below each block.
#      If ALL required env vars for a block are set, .env is not read.
#
#   2. A local .env file (for local development).
#      Copy this file to `.env` (same directory), fill in real values.
#      The .env file is gitignored.
#
# Two parser conventions are used by scripts in this repo:
#   - cashflow_db.py / loan_db.py / apply_schema_*.py:
#     read forward from `# HEADER` marker until next `#` block.
#     Keys go AFTER marker.
#   - sync_counterparties.py / sync_portfolios.py / sync_users.py /
#     snapshot_tokens.py:
#     lookback window around `# t2x-ro-mysql` marker.
#     Keys go BEFORE marker.
# Layout below respects both.

# Postgres UAT — trades_cashflow, trades_loan, trade_seq_* sequences.
# Used by: apply_schema_cashflow.py, apply_schema_loan.py,
#          apply_schema_loan_cashflow_map.py, cashflow_db.py, loan_db.py.
# Env-var alternatives: MO_DB_HOST, MO_DB_PORT, MO_DB_DATABASE,
#                       MO_DB_USERNAME, MO_DB_PASSWORD.
# MO DB UAT
MO_DB_HOST: <postgres-host>
MO_DB_PORT: 5432
MO_DB_DATABASE: <db-name>
MO_DB_USERNAME: <user>
MO_DB_PASSWORD: <password>

# MySQL t2x read-only — reference_data.{counterparty, portfolio, user,
# instrument_token_grouped}.
# Used by: sync_counterparties.py, sync_portfolios.py, sync_users.py,
#          snapshot_tokens.py.
# Env-var alternatives: T2X_RO_MYSQL_HOST, T2X_RO_MYSQL_USERNAME,
#                       T2X_RO_MYSQL_PASSWORD.
# Keys must go ABOVE the marker (parser uses lookback window).
host: <mysql-ro-host>
username: <user>
password: <password>
# t2x-ro-mysql

# Goldrush (Covalent) API key for the cashflow tx-hash auto-fill feature.
# Get one at https://goldrush.dev/
GOLDRUSH_API_KEY=

# Binance VIP loan — READ-ONLY API key/secret (account 818).
# Used by: binance_vip_loan_ltv.py (Loan Enquiry LTV tile).
# Credential precedence in the script:
#   1. /vault/secret/gw_secret.json   (Vault agent-inject sidecar, prod)
#   2. BINANCE_API_KEY / BINANCE_API_SECRET env vars (k8s Secret, UAT)
#   3. this .env block (local dev only)
# The parser matches the key NAME by suffix and accepts ':' or '=', so an
# account-number prefix is fine (e.g. 818.BINANCE_API_KEY=...).
818.BINANCE_API_KEY=
818.BINANCE_API_SECRET=
